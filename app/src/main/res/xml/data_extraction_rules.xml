<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude session JWT and user credentials DataStore file from cloud backups -->
        <exclude domain="file" path="datastore/aguia_session.preferences_pb" />
        <exclude domain="sharedpref" path="aguia_session" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude session JWT and user credentials DataStore file from device-to-device transfers -->
        <exclude domain="file" path="datastore/aguia_session.preferences_pb" />
        <exclude domain="sharedpref" path="aguia_session" />
    </device-transfer>
</data-extraction-rules>
